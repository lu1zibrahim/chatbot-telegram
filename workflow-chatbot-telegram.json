    {
      "parameters": {
        "jsCode": "// Get the user's message\nconst userInput = $input.item.json.queue;\n\n// Remove accents\nlet normalized = userInput\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .trim();\n\n// Handle Brazilian format: \"City,SP\" → \"City,BR\"\n// Replace state codes with country code\nif (normalized.includes(',')) {\n  const parts = normalized.split(',');\n  const city = parts[0].trim();\n  // Add BR (Brazil country code) for better results\n  normalized = `${city},BR`;\n}\n\n// Return cleaned data\nreturn {\n  json: {\n    queue: normalized\n  }\n};"
      },
